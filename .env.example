# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of Telegram User IDs for Admin privileges (e.g. 12345678,87654321)
ADMIN_IDS=123456789

# Database path (default: bot.db)
DATABASE_PATH=bot.db

# Directory for storing temporary downloads
DOWNLOAD_DIR=downloads

# Max concurrent media downloads at any given moment
MAX_CONCURRENT_DOWNLOADS=3

# Rate limit: Maximum download requests allowed per user per minute
RATE_LIMIT_PER_MINUTE=5

# Automatic chat message cleanup: Delete messages after N hours (Default: 24)
AUTO_DELETE_HOURS=24

# Interval (in minutes) for the auto-delete background worker (Default: 15)
CLEANUP_INTERVAL_MINUTES=15

# Optional: Netscape-format YouTube cookies string for datacenter IP bypass
# COOKIES_TEXT=
